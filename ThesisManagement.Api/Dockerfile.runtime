# ============================================
# Runtime Dockerfile for ThesisManagement.Api
# Packages pre-built DLL from artifact
# ============================================

FROM mcr.microsoft.com/dotnet/aspnet:8.0

# Create non-root user for security
RUN groupadd --gid 1000 appgroup && \
    useradd --uid 1000 --gid appgroup --shell /bin/bash appuser

WORKDIR /app

# Copy pre-built published files
COPY . ./

# Set ownership
RUN chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Environment defaults
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:8080

# Expose internal port (not published to host)
EXPOSE 8080

# Healthcheck using wget (available in aspnet base image)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1

# Entry point - uses DLL name from .csproj AssemblyName
ENTRYPOINT ["dotnet", "ThesisManagement.Api.dll"]
